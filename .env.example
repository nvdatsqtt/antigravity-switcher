# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO ANTIGRAVITY ACCOUNT SWITCHER (.env.example)
# Sao chép tệp này thành .env để tùy chỉnh (nếu cần):
# cp .env.example .env
# ==============================================================================

# 1. Tùy chỉnh Google OAuth Client (Mặc định sử dụng Client chính thức của Antigravity)
# ANTIGRAVITY_GOOGLE_CLIENT_ID=1071006060591-tmhssin2h21lcre235vtolojh4g403ep.apps.googleusercontent.com
# ANTIGRAVITY_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# 2. Tùy chỉnh đường dẫn file thực thi Antigravity IDE (nếu cài ở vị trí tùy chỉnh)
# ANTIGRAVITY_IDE_PATH=/opt/AntigravityIDE/antigravity-ide

# 3. Tùy chỉnh đường dẫn file thực thi Antigravity Desktop Hub
# ANTIGRAVITY_APP_PATH=/opt/Antigravity/antigravity

